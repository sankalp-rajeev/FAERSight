* text=auto
*.py text eol=lf
*.java text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.arff text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.lock text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
# Frozen evidence must retain the exact bytes referenced by its SHA-256 manifests.
/artifacts/manifests/** -text
# Raw tool logs contain CRLF and separator lines that are not source-code whitespace/conflicts.
/artifacts/manifests/**/*.log -diff
/artifacts/manifests/**/*.csv whitespace=cr-at-eol
